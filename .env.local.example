# Variáveis para conectar o app ao Supabase.
# Copie para .env.local.
#
# Para usar o Supabase local, rode:
#   .\scripts\start-local.ps1
# ou manualmente:
#   supabase start
#   (os valores aparecem no output do comando acima)
#
# Para usar um projeto remoto do Supabase, substitua pelos valores hospedados:
#   VITE_SUPABASE_URL=https://seu_project_ref.supabase.co
#   VITE_SUPABASE_ANON_KEY=sua_anon_key_remota

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# White Label — slug da marca ativa.
# Valores aceitos: kaboo (padrão), central-coruja
# Pode ser omitido; o app resolve automaticamente por hostname.
# VITE_BRAND_SLUG=kaboo
