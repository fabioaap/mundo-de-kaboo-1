{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "tests/**/*.ts",
        "playwright.config.ts"
    ]
}