#!/bin/bash
# .git/hooks/pre-commit
# 1) Gate determinístico (secret-scan + SQL destrutivo) — BLOQUEIA o commit em violação.
# 2) Auto-update de documentação (não bloqueia).

# Cores
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# ── Gate determinístico (bloqueante) ──────────────────────────────────
echo -e "${YELLOW}🛡️  QA gate: secret-scan + SQL destrutivo (staged)...${NC}"
node scripts/qa/check-staged.mjs
if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Commit bloqueado pelo QA gate. Corrija os itens acima.${NC}"
    exit 1
fi

echo -e "${YELLOW}🔄 Atualizando documentações...${NC}"

# Rodar script de documentação
npm run update-docs

# Verificar se o script completo com sucesso
if [ $? -ne 0 ]; then
    echo -e "${YELLOW}⚠️  Aviso: update-docs teve um erro, continuando commit...${NC}"
else
    echo -e "${GREEN}✅ Documentações atualizadas!${NC}"
    
    # Adicionar arquivos gerados ao commit
    git add docs/COMPONENTES.md
    git add docs/HOOKS.md
    git add docs/SCREENS.md
    git add docs/API.md
    git add docs/CHANGELOG.md
    git add INFRAESTRUTURA.md
    
    echo -e "${GREEN}📝 Arquivos de documentação adicionados ao commit${NC}"
fi

exit 0
