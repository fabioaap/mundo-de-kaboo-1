#!/bin/bash
# .githooks/pre-push
# Gate determinístico antes do push: typecheck + testes unitários.
# Bloqueia o push se qualquer um falhar. (Push remoto continua exclusivo do @devops.)

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${YELLOW}🔎 pre-push: typecheck (tsc --noEmit)...${NC}"
npm run typecheck
if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Push bloqueado: erros de tipo. Corrija antes de enviar.${NC}"
    exit 1
fi

echo -e "${YELLOW}🧪 pre-push: testes unitários (vitest)...${NC}"
npm run test:unit
if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Push bloqueado: testes unitários falhando.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ pre-push OK (typecheck + unit).${NC}"
exit 0
